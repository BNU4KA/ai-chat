[Unit]
Description=AI Chat background worker
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
User=aichat
Group=aichat
WorkingDirectory=/opt/ai-chat/current
EnvironmentFile=/etc/ai-chat/server.env
Environment=NODE_OPTIONS=--max-old-space-size=256
ExecStart=/opt/ai-chat/toolchain/node/bin/node apps/worker/src/index.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
UMask=0077
MemoryHigh=512M
MemoryMax=700M

[Install]
WantedBy=multi-user.target
